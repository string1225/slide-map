.intro {
  padding: 18rpx 32rpx 10rpx;
}
.brand {
  width: 76rpx;
  height: 76rpx;
  border-radius: 28rpx;
}
.intro .title {
  font-size: 34rpx;
}
.intro .eyebrow {
  font-size: 17rpx;
  letter-spacing: 3rpx;
}
.intro .subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
}
.searchbar button.small {
  flex: none;
  width: 96rpx;
  padding: 10rpx 0;
  font-size: 24rpx;
  color: #fffdf4;
  background: #205b46;
}
.filters button.chip {
  flex: none;
  width: auto;
  padding: 10rpx 20rpx;
  font-size: 23rpx;
}
.searchbar {
  margin: 15rpx 32rpx 22rpx;
  padding: 10rpx 12rpx 10rpx 24rpx;
  border: 1rpx solid #dfe3d6;
  border-radius: 22rpx;
  background: #fffef9;
}
.searchbar input {
  font-size: 27rpx;
}
.search-icon {
  font-size: 40rpx;
  color: #74836e;
}
.filter-scroll {
  width: 100%;
}
.filters {
  display: flex;
  gap: 12rpx;
  padding: 0 32rpx;
  width: max-content;
}
.toolbar {
  padding: 14rpx 32rpx;
}
.toolbar button {
  font-weight: 400;
}
.map-wrap {
  margin: 0 22rpx;
  border-radius: 28rpx;
  overflow: hidden;
  border: 1rpx solid #dbe2cf;
}
.map {
  width: 100%;
  height: 590rpx;
}
.map-locate {
  position: absolute;
  right: 14px;
  top: 14px;
  background: #fffef9;
  color: #205b46;
  border-radius: 12px;
  padding: 13px;
  font-size: 14px;
  box-shadow: 0 2px 10px #bbc7b0;
}
.map-search {
  position: absolute;
  left: 28%;
  bottom: 18px;
  background: #205b46;
  color: white;
  padding: 14px 20px;
  border-radius: 24px;
  font-size: 14px;
}
.results {
  padding: 25rpx 32rpx;
}
.results-title {
  margin: 10rpx 0 20rpx;
}
.results-title .section-title {
  font-size: 30rpx;
  margin: 0;
}
.sort {
  font-size: 23rpx;
  color: #7c8775;
}
.sort.chosen {
  color: #205b46;
  font-weight: 700;
}
.place-title {
  font-size: 31rpx;
  font-weight: 650;
  margin-bottom: 8rpx;
}
.featured {
  box-shadow: 0 10rpx 35rpx #253e3208;
}
.footnote {
  text-align: center;
  font-size: 22rpx;
  color: #94a08a;
  padding: 24rpx 0;
}
.notice {
  margin: 10rpx 32rpx;
}
