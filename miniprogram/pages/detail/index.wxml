<view wx:if="{{loading}}" class="loading">正在打开这份快乐…</view><view wx:if="{{error}}" class="page"><view class="notice error">{{error}}</view><button bindtap="retry">重新加载</button></view>
<block wx:if="{{slide}}"><map class="detail-map" subkey="{{mapKey}}" latitude="{{slide.latitude}}" longitude="{{slide.longitude}}" markers="{{markers}}" scale="16" enable-scroll="{{false}}" enable-zoom="{{false}}" bindtap="navigate"/>
<view class="page detail-body"><view class="row"><text class="tag">{{slide.type}}</text><text class="rating">★ {{slide.ratingLabel}} <text class="muted">/ {{slide.reviewCount}} 条评价</text></text></view><view class="title">{{slide.title}}</view><view class="subtitle">{{slide.address}}</view><view class="actions"><button class="primary" bindtap="navigate">↗ 一键导航</button><button class="ghost" bindtap="favorite">{{slide.isFavorite?'♥ 已收藏':'♡ 收藏'}}</button><button class="ghost" open-type="share">分享</button></view>
<scroll-view wx:if="{{photos.length}}" class="gallery section" scroll-x><view class="gallery-row"><image wx:for="{{photos}}" wx:key="*this" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewPhoto"/></view></scroll-view>
<view class="info-grid section"><view><text class="muted">适合年龄</text><view>{{slide.ageBand}}</view></view><view><text class="muted">收费情况</text><view>{{slide.cost}}</view></view><view class="wide"><text class="muted">开放时间</text><view>{{slide.openingHours}}</view></view></view>
<view class="section"><view class="section-title">关于这座滑梯</view><view class="description">{{slide.description}}</view><view class="section"><text wx:for="{{slide.amenities}}" wx:key="*this" class="tag">✓ {{item}}</text></view><view class="byline muted">{{slide.creatorName}} 分享于 {{slide.dateLabel}}</view></view>
<view wx:if="{{slide.parking || slide.parkingAddress || slide.traffic}}" class="section"><view class="section-title">怎么去，怎么停</view><text wx:if="{{slide.parking}}" class="tag">{{slide.parking}}</text><view wx:if="{{slide.parkingAddress}}" class="card"><text class="label">停车场地址</text><view>{{slide.parkingAddress}}</view><button wx:if="{{slide.parkingLocation}}" class="ghost small section" bindtap="navigateParking">↗ 导航到停车场</button></view><view wx:if="{{slide.traffic}}" class="description">{{slide.traffic}}</view></view>
<view wx:if="{{slide.isOwner}}" class="actions"><button class="ghost small" bindtap="edit">编辑信息</button><button class="danger small" bindtap="remove">删除分享</button></view>
<view class="section"><view class="row"><view class="section-title">大家的体验 · {{slide.reviewCount}}</view><text class="link" bindtap="report">信息有误？</text></view><view wx:if="{{!reviews.length}}" class="card muted">还没有评价，期待你的第一次探访。</view><view wx:for="{{reviews}}" wx:key="id" class="card"><view class="row"><view><view>{{item.nickname}}</view><view class="stars">{{item.starLabel}}</view></view><text class="muted">{{item.dateLabel}}</text></view><view class="review-text">{{item.content}}</view></view><button wx:if="{{nextOffset!==null}}" class="ghost" bindtap="more">查看更多评价</button></view>
<view wx:if="{{!slide.isOwner}}" class="card section"><view class="section-title">{{slide.myReview?'更新我的评价':'你玩得开心吗？'}}</view><view class="rate-picker"><button wx:for="{{stars}}" wx:key="*this" data-value="{{item}}" bindtap="star" aria-label="{{item}}星" class="{{rating>=item?'filled':''}}">★</button></view><textarea class="textarea" value="{{content}}" bindinput="content" placeholder="聊聊真实体验，给下一个家庭一点参考（5–500字）" maxlength="500"/><button class="primary section" bindtap="submit" disabled="{{busy}}" loading="{{busy}}">{{slide.myReview?'更新评分与评价':'提交评分与评价'}}</button><view wx:if="{{slide.myReview}}" class="remove-review link" bindtap="removeReview">删除我的评价</view></view>
<view class="notice">设施状态可能变化，出发前请留意开放信息；游玩时请陪同照看孩子。</view></view></block><privacy-dialog id="privacy"/>
